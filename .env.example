# BBH Web — variables de entorno (copiar a `.env` local o al hosting de despliegue).
# NUNCA commitear este fichero ni valores reales de secretos.

# Proyecto Supabase
SUPABASE_PROJECT_ID=""

# URL del proyecto Supabase
SUPABASE_URL="https://PROJECT-REF.supabase.co"

# Publishable (anon) key — visible en cliente, NO es secreta
SUPABASE_PUBLISHABLE_KEY=""

# Service-role key — SOLO servidor. Nunca en el repo ni en el bundle de cliente.
# Se configura en el entorno de despliegue (panel del host: Vercel, Netlify, VPS…)
SUPABASE_SERVICE_ROLE_KEY=""

# Variantes VITE_ usadas por el bundle de cliente (mismos valores que las de arriba)
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""